# =======================
# Auth0 Configuration
# =======================
# A long secret value used to encrypt the session cookie
# Generate with: openssl rand -hex 32
AUTH0_SECRET=your_long_random_secret_here

# The base URL of your application
AUTH0_BASE_URL=http://localhost:3000

# Your Auth0 tenant domain URL
AUTH0_ISSUER_BASE_URL=https://YOUR_AUTH0_DOMAIN.auth0.com

# Your Auth0 application's Client ID
AUTH0_CLIENT_ID=your_auth0_client_id

# Your Auth0 application's Client Secret
AUTH0_CLIENT_SECRET=your_auth0_client_secret

# Your Auth0 API's Identifier (optional - for API access)
AUTH0_AUDIENCE=your_auth0_api_identifier

# The permissions your app is asking for (optional)
AUTH0_SCOPE=openid profile email read:shows

# =======================
# Notion API Configuration
# =======================
# Your Notion OAuth application credentials
# Get these from: https://developers.notion.com/
NOTION_OAUTH_CLIENT_ID=your_notion_oauth_client_id
NOTION_OAUTH_CLIENT_SECRET=your_notion_oauth_client_secret

# Notion OAuth authorization URL for your app
NEXT_PUBLIC_NOTION_AUTHORIZATION_URL=https://api.notion.com/v1/oauth/authorize?client_id=YOUR_CLIENT_ID&response_type=code&owner=user&redirect_uri=YOUR_REDIRECT_URI

# =======================
# Google Maps API
# =======================
# Google Maps API key for client-side map rendering
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google Maps API key for server-side Places API calls
# Can be the same as above, but keeping separate for security
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# =======================
# Supabase Configuration
# =======================
# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anon/public API key
SUPABASE_KEY=your_supabase_anon_key

# =======================
# Development Configuration
# =======================
# API port (optional, defaults to 3001 for legacy compatibility)
API_PORT=3001